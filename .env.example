# ============================================
# Agent Triage — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your API keys.
# You need at least ONE provider configured to use the platform.

# ============================================
# LLM PROVIDERS
# ============================================

# OpenAI (required for coding, devops, debugging, design, planning agents)
OPENAI_API_KEY=sk-...

# Anthropic Claude (required for research and architecture agents)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional)
GOOGLE_API_KEY=AIza...

# DeepSeek (optional — OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...

# Groq (optional — fast inference, OpenAI-compatible)
GROQ_API_KEY=gsk_...

# Ollama (optional — local models)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
